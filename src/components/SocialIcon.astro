---
interface Props { url: string; icon?: 'auto'|'website'|'email'|'instagram'|'youtube'|'soundcloud'|'linktree'|'spotify'|'none'; }
const host=new URL(Astro.props.url).hostname.replace(/^www\./,'');
const detected=Astro.props.url.startsWith('mailto:')?'email':host==='instagram.com'?'instagram':host==='youtube.com'||host==='youtu.be'?'youtube':host==='soundcloud.com'?'soundcloud':host==='linktr.ee'?'linktree':host==='open.spotify.com'||host==='spotify.com'?'spotify':'website';
const icon=Astro.props.icon&&Astro.props.icon!=='auto'?Astro.props.icon:detected;
---
{icon!=='none'&&<svg class="social-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {icon==='email'?<><rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></>:
   icon==='instagram'?<><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7" fill="currentColor" stroke="none"/></>:
   icon==='youtube'?<><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="m10 9 5 3-5 3Z" fill="currentColor" stroke="none"/></>:
   icon==='soundcloud'?<><path d="M2 13v3m3-6v8m3-10v10m3-11v11h7a4 4 0 0 0 0-8 5 5 0 0 0-7-4"/></>:
   icon==='linktree'?<><path d="M12 3v10M5 6l7 7 7-7M3 12h18M12 13l-7 7m7-7 7 7M12 17v5"/></>:
   icon==='spotify'?<><circle cx="12" cy="12" r="9"/><path d="M6.5 9c3-1.4 7-1.3 11 .5M7.5 12c3-1 6-1 9 .5M8.5 15c2-.7 4-.6 7 .4"/></>:
   <><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></>}
</svg>}
