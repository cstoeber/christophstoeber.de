---
import ResponsiveImage from './ResponsiveImage.astro';
interface Props { url: string; icon?: 'auto'|'website'|'email'|'instagram'|'youtube'|'soundcloud'|'linktree'|'spotify'|'none'; }
const host=new URL(Astro.props.url,Astro.site||Astro.url).hostname.replace(/^www\./,'');
const detected=Astro.props.url.startsWith('mailto:')?'email':host==='instagram.com'?'instagram':host==='youtube.com'||host==='youtu.be'?'youtube':host==='soundcloud.com'?'soundcloud':host==='linktr.ee'?'linktree':host==='open.spotify.com'||host==='spotify.com'?'spotify':'website';
const icon=Astro.props.icon&&Astro.props.icon!=='auto'?Astro.props.icon:detected;
const handdrawnIcons:Record<string,string|undefined>={
  instagram:'/images/icons/instagram-handdrawn.jpg',
  email:'/images/icons/mail-handdrawn.jpg',
  linktree:'/images/icons/linktree-handdrawn.jpg',
  youtube:'/images/icons/youtube-handdrawn.jpg',
  soundcloud:'/images/icons/soundcloud-handdrawn.jpg',
  website:'/images/icons/internet-handdrawn.jpg',
};
const handdrawn=handdrawnIcons[icon];
---
{handdrawn?<ResponsiveImage class="social-icon social-icon-handdrawn" src={handdrawn} alt="" aria-hidden="true" sizes="18px" width="18" height="18" decoding="async"/>:icon!=='none'&&<svg class="social-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {icon==='spotify'?<><circle cx="12" cy="12" r="9"/><path d="M6.5 9c3-1.4 7-1.3 11 .5M7.5 12c3-1 6-1 9 .5M8.5 15c2-.7 4-.6 7 .4"/></>:
   <><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></>}
</svg>}
