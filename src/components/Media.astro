---
import previews from '../data/media-previews.json';
import ResponsiveImage from './ResponsiveImage.astro';
interface Props {title:string;url:string;poster?:string|null;}
const {title,url,poster}=Astro.props;
const host=new URL(url).hostname;
const type=host.includes('youtube')||host==='youtu.be'?'video':host==='open.spotify.com'?'spotify':'soundcloud';
const provider=type==='video'?'YouTube':type==='spotify'?'Spotify':'SoundCloud';
const thumbnail=(poster?.startsWith('/')&&!poster.startsWith('//')?poster:undefined)||(previews as Record<string,string>)[url]||'/images/astronaut-button.png';
---
<div class="media-entry" data-provider={type} data-url={url} data-title={title}>
  <div class:list={['media',type]}>
    <button class="media-preview has-thumbnail" type="button" aria-haspopup="dialog" aria-label={`${title} – ${provider} laden`}>
      <ResponsiveImage src={thumbnail} alt="" loading="lazy" decoding="async" layout="preview"/>
      <span class="media-play" aria-hidden="true">▶</span>
      <span class="media-caption"><span>{title}</span><span class="media-load-label">{provider} laden</span></span>
    </button>
  </div>
  {type==='spotify'&&<p class="media-direct"><a href={url.replace('/embed/','/')} target="_blank" rel="noopener noreferrer">Direkt auf Spotify hören ↗</a></p>}
  <noscript><a href={url}>{title} bei {provider} öffnen</a></noscript>
</div>
