---
import '@fontsource/karla/latin-400.css';
import '@fontsource/karla/latin-200.css';
import '@fontsource/karla/latin-700.css';
import '@fontsource/merriweather/latin-400.css';
import '@fontsource/merriweather/latin-400-italic.css';
import '@fontsource/merriweather/latin-700.css';
import '@fontsource/merriweather/latin-700-italic.css';
import '../styles/global.css';
import settings from '../data/settings.json';
import SocialIcon from '../components/SocialIcon.astro';
import EmailCTA from '../components/EmailCTA.astro';
import MediaConsentDialog from '../components/MediaConsentDialog.astro';
import navigationSettings from '../data/navigation.json';
import {getCollection} from 'astro:content';
import {resolveNavigation} from '../lib/navigation';
const navigation={items:resolveNavigation(navigationSettings.items,await getCollection('pages'))};
interface Props { title: string; description?: string; noindex?: boolean; }
const {title,description='Christoph Stöber – Pianist, Komponist und Klavierpädagoge in Köln.',noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
const titleParts=settings.title.split(/\s+(?:[-–—]|🧑‍🚀)\s+/);
const searchTitles:Record<string,string>={
  '/':'Christoph Stöber | Pianist & Klavierunterricht in Köln',
  '/unterricht/':'Klavierunterricht in Köln | Christoph Stöber',
  '/projekte/':'Musikalische Projekte & Produktion | Christoph Stöber',
  '/termine/':'Konzerte & Termine | Christoph Stöber',
  '/lebenslauf/':'Lebenslauf | Christoph Stöber, Pianist in Köln',
};
const pageTitle=searchTitles[Astro.url.pathname]||`${title} | Christoph Stöber – Pianist`;
const image=new URL('/images/start-1.jpg',Astro.site);
const personId=new URL('/#person',Astro.site).href;
const structuredData={'@context':'https://schema.org','@graph':[
  {'@type':'Person','@id':personId,name:settings.name,url:Astro.site?.href,image:image.href,jobTitle:['Pianist','Komponist','Klavierpädagoge'],email:settings.email,address:{'@type':'PostalAddress',streetAddress:settings.street,addressLocality:'Köln',postalCode:'50827',addressCountry:'DE'},sameAs:settings.socials.map(social=>social.url)},
  {'@type':'WebSite','@id':new URL('/#website',Astro.site).href,url:Astro.site?.href,name:'Christoph Stöber | Pianist',inLanguage:'de-DE',publisher:{'@id':personId}},
  {'@type':'WebPage','@id':canonical.href,url:canonical.href,name:pageTitle,description,inLanguage:'de-DE',isPartOf:{'@id':new URL('/#website',Astro.site).href},about:{'@id':personId}},
]};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex&&<meta name="robots" content="noindex,follow"/>}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Christoph Stöber | Pianist" />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Christoph Stöber am See im Park" />
    <meta property="og:image:width" content="1820" />
    <meta property="og:image:height" content="1213" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {!noindex&&<script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g,'\\u003c')} />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt</a>
    <header class="header">
      <div class="header-inner">
        <a class="site-title" href="/" aria-label={`${settings.title} – Start`}>{titleParts.map((part,index)=><>{index>0&&<img class="title-image" src="/images/astronaut-button.png" alt="" width="32" height="32"/>}{part}</>)}</a>
        <button class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="navigation"><span></span><span></span><span></span></button>
        <div class="navigation-row"><nav id="navigation" aria-label="Hauptnavigation">
          <ul>{navigation.items.map(({href,label})=><li><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a></li>)}</ul>
        </nav><a class="compact-title" href="/" aria-label={`${settings.title} – Start`} inert>{titleParts.map((part,index)=><>{index>0&&<img class="title-image" src="/images/astronaut-button.png" alt="" width="24" height="24"/>}{part}</>)}</a></div>
      </div>
    </header>
    <main id="inhalt" class="content" tabindex="-1"><slot /></main>
    <aside class="contact" aria-labelledby="contact-title">
      <div class="container">
        <h2 id="contact-title">Kontakt</h2>
        <div class="contact-details">
          <address>{settings.name}<br />{settings.street}<br />{settings.city}</address>
          <ul class="social-links" aria-label="Social Media">
            {settings.socials.map(social=><li><a href={social.url}><SocialIcon url={social.url}/><span>{social.label}</span></a></li>)}
          </ul>
        </div>
      </div>
    </aside>
    <div class="contact-email-area container"><EmailCTA/></div>
    <footer><div class="container footer-inner"><ul class="footer-links" aria-label="Rechtliches und Seitenübersicht"><li><a href="/about/">Impressum</a></li><li><a href="/datenschutz/">Datenschutz</a></li><li><a href="/sitemap/">Sitemap</a></li><li><button class="media-reset" type="button">Medienfreigaben zurücksetzen</button></li></ul><span class="media-reset-status visually-hidden" role="status"></span></div></footer>
    <MediaConsentDialog/>
    <script>
      import '../scripts/media-consent';
      const button=document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav=document.querySelector('#navigation');
      function closeMenu(){button?.setAttribute('aria-expanded','false');button?.setAttribute('aria-label','Menü öffnen');nav?.classList.remove('is-open');}
      button?.addEventListener('click',()=>{const open=button.getAttribute('aria-expanded')!=='true';button.setAttribute('aria-expanded',String(open));button.setAttribute('aria-label',open?'Menü schließen':'Menü öffnen');nav?.classList.toggle('is-open',open);});
      document.addEventListener('keydown',event=>{if(event.key==='Escape'){closeMenu();button?.focus();}});
      matchMedia('(min-width:960px)').addEventListener('change',closeMenu);
      const header=document.querySelector<HTMLElement>('.header');
      const largeTitle=document.querySelector<HTMLAnchorElement>('.site-title');
      const compactTitle=document.querySelector<HTMLAnchorElement>('.compact-title');
      const desktop=matchMedia('(min-width:960px)');
      let compact=false;
      let scheduled=false;
      function updateHeader(){
        scheduled=false;
        compact=desktop.matches&&(compact?window.scrollY>24:window.scrollY>120);
        header?.classList.toggle('is-compact',compact);
        if(largeTitle)largeTitle.inert=compact;
        if(compactTitle)compactTitle.inert=!compact;
      }
      window.addEventListener('scroll',()=>{if(!scheduled){scheduled=true;requestAnimationFrame(updateHeader);}},{passive:true});
      desktop.addEventListener('change',updateHeader);
      updateHeader();
      if(header&&document.querySelector('.hero')){
        const updateHeroHeight=()=>{
          if(!desktop.matches&&button?.getAttribute('aria-expanded')!=='true'){
            document.documentElement.style.setProperty('--mobile-header-height',`${header.getBoundingClientRect().height}px`);
          }
        };
        new ResizeObserver(updateHeroHeight).observe(header);
        updateHeroHeight();
      }
    </script>
  </body>
</html>
